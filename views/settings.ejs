<!-- backend/views/settings.ejs -->
<!-- CORRECTED to use relative image paths for the admin panel -->

<%- include('partials/_header') %>
<%- include('partials/_sidebar') %>

<div class="max-w-4xl mx-auto">
    <!-- Form Card -->
    <div class="card">
        <form id="settingsForm">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-2xl font-bold text-gray-800"><%= title %></h2>
                <p class="mt-1 text-sm text-gray-500">Manage global settings for the entire website from one place.</p>
            </div>

            <div class="divide-y divide-gray-200">
                <!-- Download & Media Section -->
                <div class="p-6 space-y-6">
                    <h3 class="text-lg font-semibold text-gray-800">Site Media & Downloads</h3>
                    
                    <!-- Logo Upload -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Logo</label>
                        <div class="mt-2 flex items-center space-x-6">
                            <div class="shrink-0">
                                <!-- THIS IS THE CORRECTED LINE -->
                                <img id="logo-preview" 
                                     src="<%= (settings && settings.logoUrl) ? settings.logoUrl : 'https://via.placeholder.com/128' %>" 
                                     alt="Logo preview" 
                                     class="h-24 w-24 object-contain rounded-md bg-gray-50 p-1 border">
                            </div>
                            <div class="flex-grow">
                                <input type="hidden" id="logoUrl" value="<%= settings ? settings.logoUrl : '' %>">
                                <label for="logo-upload-input" class="btn btn-secondary cursor-pointer">
                                    <span>Upload Logo</span>
                                </label>
                                <input id="logo-upload-input" type="file" class="sr-only">
                                <p class="mt-2 text-xs text-gray-500">PNG, JPG, SVG, WEBP up to 5MB.</p>
                                <div id="logo-upload-status" class="mt-2 text-sm"></div>
                            </div>
                        </div>
                    </div>

                    <!-- QR Code Upload -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700">QR Code Image</label>
                        <div class="mt-2 flex items-center space-x-6">
                             <div class="shrink-0">
                                <!-- THIS IS THE CORRECTED LINE -->
                                <img id="qr-preview" 
                                     src="<%= (settings && settings.qrCodeImageUrl) ? settings.qrCodeImageUrl : 'https://via.placeholder.com/128' %>" 
                                     alt="QR Code preview" 
                                     class="h-24 w-24 object-contain rounded-md bg-gray-50 p-1 border">
                            </div>
                            <div class="flex-grow">
                                <input type="hidden" id="qrCodeImageUrl" value="<%= settings ? settings.qrCodeImageUrl : '' %>">
                                <label for="qr-upload-input" class="btn btn-secondary cursor-pointer">
                                    <span>Upload QR Code</span>
                                </label>
                                <input id="qr-upload-input" type="file" class="sr-only">
                                <p class="mt-2 text-xs text-gray-500">PNG, JPG, SVG, WEBP up to 5MB.</p>
                                <div id="qr-upload-status" class="mt-2 text-sm"></div>
                            </div>
                        </div>
                    </div>

                    <!-- APK Link -->
                    <div>
                        <label for="apkDownloadLink" class="block text-sm font-medium text-gray-700">APK Download Link</label>
                        <input type="text" id="apkDownloadLink" value="<%= settings ? settings.apkDownloadLink : '' %>" required class="form-input">
                    </div>
                </div>

                <!-- Mobile Splash Video Section -->
                <div class="p-6 space-y-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800">Mobile Splash Video</h3>
                            <p class="mt-1 text-sm text-gray-500">Plays full-screen on phones the first time someone opens the site (once per visit). Muted, with a Skip button; the site appears when the video ends.</p>
                        </div>
                        <label for="showSplashVideo" class="inline-flex items-center gap-2 cursor-pointer shrink-0 mt-1">
                            <input type="checkbox" id="showSplashVideo" class="form-checkbox h-5 w-5" <%= (settings && settings.showSplashVideo) ? 'checked' : '' %>>
                            <span class="text-sm font-medium text-gray-700">Enabled</span>
                        </label>
                    </div>

                    <div class="flex flex-col md:flex-row md:items-start gap-6">
                        <div class="shrink-0">
                            <video id="splash-video-preview" class="w-40 aspect-[9/16] object-cover rounded-md bg-gray-900 border <%= (settings && settings.splashVideoUrl) ? '' : 'hidden' %>"
                                   src="<%= settings ? settings.splashVideoUrl : '' %>" muted playsinline controls preload="metadata"></video>
                            <div id="splash-video-empty" class="w-40 aspect-[9/16] rounded-md bg-gray-100 border border-dashed grid place-items-center text-xs text-gray-400 text-center p-2 <%= (settings && settings.splashVideoUrl) ? 'hidden' : '' %>">No video yet</div>
                        </div>
                        <div class="flex-grow space-y-3">
                            <div class="flex flex-wrap items-center gap-3">
                                <label for="splash-video-upload-input" class="btn btn-secondary cursor-pointer">
                                    <span>Upload Video</span>
                                </label>
                                <input id="splash-video-upload-input" type="file" accept="video/mp4,video/webm" class="sr-only">
                                <button type="button" id="splash-video-remove" class="text-sm font-medium text-red-600 hover:text-red-800">Remove video</button>
                            </div>
                            <p class="text-xs text-gray-500">MP4 (H.264) or WebM, up to 30MB. Vertical 9:16 looks best. Keep it short (3&ndash;8 seconds) and small (ideally under 3MB) so it starts instantly on mobile data.</p>
                            <div id="splash-video-upload-status" class="text-sm"></div>
                            <div>
                                <label for="splashVideoUrl" class="block text-sm font-medium text-gray-700">Video URL</label>
                                <input type="url" id="splashVideoUrl" value="<%= settings ? settings.splashVideoUrl : '' %>" class="form-input" placeholder="Filled automatically after upload, or paste a direct .mp4 link">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Social & Support Links Section -->
                <div class="p-6 space-y-4">
                     <h3 class="text-lg font-semibold text-gray-800">Social & Support Links</h3>
                     <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div><label for="telegramUrl" class="block text-sm font-medium">Telegram URL</label><input type="url" id="telegramUrl" value="<%= settings ? settings.telegramUrl : '' %>" class="form-input"></div>
                        <div><label for="whatsappUrl" class="block text-sm font-medium">WhatsApp URL</label><input type="url" id="whatsappUrl" value="<%= settings ? settings.whatsappUrl : '' %>" class="form-input"></div>
                        <div><label for="instagramUrl" class="block text-sm font-medium">Instagram URL</label><input type="url" id="instagramUrl" value="<%= settings ? settings.instagramUrl : '' %>" class="form-input"></div>
                        <div><label for="facebookUrl" class="block text-sm font-medium">Facebook URL</label><input type="url" id="facebookUrl" value="<%= settings ? settings.facebookUrl : '' %>" class="form-input"></div>
                        <div><label for="youtubeUrl" class="block text-sm font-medium">YouTube URL</label><input type="url" id="youtubeUrl" value="<%= settings ? settings.youtubeUrl : '' %>" class="form-input"></div>
                        <div><label for="twitterUrl" class="block text-sm font-medium">Twitter (X) URL</label><input type="url" id="twitterUrl" value="<%= settings ? settings.twitterUrl : '' %>" class="form-input"></div>
                        <div><label for="liveChatUrl" class="block text-sm font-medium">Live Chat URL</label><input type="url" id="liveChatUrl" value="<%= settings ? settings.liveChatUrl : '' %>" class="form-input"></div>
                     </div>

                     <!-- More Social Links (pick a platform from the list, as many as needed) -->
                     <div class="pt-4 mt-2 border-t border-gray-100">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <h4 class="text-sm font-semibold text-gray-800">More Social Links</h4>
                                <p class="text-xs text-gray-500 mt-0.5">Pick a platform and paste the link. They appear in the website footer after the links above, in this order.</p>
                            </div>
                            <button type="button" id="add-social-link" class="btn btn-secondary inline-flex items-center gap-1">
                                <i class="ri-add-line"></i> Add Link
                            </button>
                        </div>
                        <div id="extra-social-list" class="mt-4 space-y-3"></div>
                        <p id="extra-social-empty" class="mt-4 text-sm text-gray-400 italic">No extra links yet. Click "Add Link" to add TikTok, Threads, Discord and more.</p>
                     </div>
                </div>

                <!-- Technical SEO Settings Section -->
                <div class="p-6 space-y-4">
                     <h3 class="text-lg font-semibold text-gray-800">Technical SEO Settings</h3>
                     
                     <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label for="googleAnalyticsId" class="block text-sm font-medium text-gray-700">Google Analytics ID</label>
                            <input type="text" id="googleAnalyticsId" value="<%= settings ? settings.googleAnalyticsId : '' %>" class="form-input" placeholder="e.g., G-XXXXXXXXXX">
                        </div>
                        <div>
                            <label for="googleSearchConsoleVerification" class="block text-sm font-medium text-gray-700">Google Search Console Meta Value</label>
                            <input type="text" id="googleSearchConsoleVerification" value="<%= settings ? settings.googleSearchConsoleVerification : '' %>" class="form-input" placeholder="Value from content='...'">
                        </div>
                        <div>
                            <label for="ahrefsVerification" class="block text-sm font-medium text-gray-700">Ahrefs Site Verification Meta Value</label>
                            <input type="text" id="ahrefsVerification" value="<%= settings ? settings.ahrefsVerification : '' %>" class="form-input" placeholder="Value from content='...'">
                        </div>
                     </div>

                     <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                        <div>
                            <label for="customHeaderScripts" class="block text-sm font-medium text-gray-700">Custom Header Scripts (Inside &lt;head&gt;)</label>
                            <textarea id="customHeaderScripts" rows="4" class="form-input font-mono text-xs" placeholder="e.g. <!-- Custom scripts -->"><%= settings ? settings.customHeaderScripts : '' %></textarea>
                        </div>
                        <div>
                            <label for="customFooterScripts" class="block text-sm font-medium text-gray-700">Custom Footer Scripts (Bottom of &lt;body&gt;)</label>
                            <textarea id="customFooterScripts" rows="4" class="form-input font-mono text-xs" placeholder="e.g. <!-- Custom scripts -->"><%= settings ? settings.customFooterScripts : '' %></textarea>
                        </div>
                     </div>
                </div>

            </div>

            <!-- Form Footer -->
            <div class="bg-gray-50 p-4 flex justify-between items-center rounded-b-lg">
                <div id="statusMessage" class="text-sm font-medium"></div>
                <button type="submit" id="submitButton" class="btn btn-primary">
                    Save Settings
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // --- REUSABLE UPLOAD HANDLER ---
    async function handleImageUpload(event, previewEl, pathInputEl, statusEl) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (e) => { previewEl.src = e.target.result; };
        reader.readAsDataURL(file);
        
        const formData = new FormData();
        formData.append('image', file);
        statusEl.textContent = 'Uploading...';
        statusEl.className = 'mt-2 text-sm text-gray-600';

        try {
            const token = document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
            const response = await fetch('/api/admin/upload', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` },
                body: formData,
            });
            const result = await response.json();
            if (!response.ok) throw new Error(result.message || 'Upload failed');
            
            pathInputEl.value = result.filePath;
            previewEl.src = result.filePath;
            statusEl.textContent = 'Upload successful!';
            statusEl.className = 'mt-2 text-sm text-green-600 font-medium';
        } catch (error) {
            statusEl.textContent = `Error: ${error.message}`;
            statusEl.className = 'mt-2 text-sm text-red-600 font-medium';
        }
    }

    // --- SETUP EVENT LISTENERS FOR EACH UPLOAD ---
    const logoUploadInput = document.getElementById('logo-upload-input');
    logoUploadInput.addEventListener('change', (event) => {
        handleImageUpload(
            event,
            document.getElementById('logo-preview'),
            document.getElementById('logoUrl'),
            document.getElementById('logo-upload-status')
        );
    });

    const qrUploadInput = document.getElementById('qr-upload-input');
    qrUploadInput.addEventListener('change', (event) => {
        handleImageUpload(
            event,
            document.getElementById('qr-preview'),
            document.getElementById('qrCodeImageUrl'),
            document.getElementById('qr-upload-status')
        );
    });

    // --- SPLASH VIDEO: upload, preview, remove ---
    const splashUrlInput = document.getElementById('splashVideoUrl');
    const splashPreview = document.getElementById('splash-video-preview');
    const splashEmpty = document.getElementById('splash-video-empty');
    const splashStatus = document.getElementById('splash-video-upload-status');

    function setSplashPreview(url) {
        if (url) {
            splashPreview.src = url;
            splashPreview.classList.remove('hidden');
            splashEmpty.classList.add('hidden');
        } else {
            splashPreview.removeAttribute('src');
            splashPreview.load();
            splashPreview.classList.add('hidden');
            splashEmpty.classList.remove('hidden');
        }
    }

    document.getElementById('splash-video-upload-input').addEventListener('change', async (event) => {
        const file = event.target.files[0];
        event.target.value = '';
        if (!file) return;
        if (file.size > 30 * 1024 * 1024) {
            splashStatus.textContent = 'Error: Video is too large. Maximum size is 30 MB.';
            splashStatus.className = 'text-sm text-red-600 font-medium';
            return;
        }

        const formData = new FormData();
        formData.append('video', file);
        splashStatus.textContent = `Uploading ${(file.size / 1024 / 1024).toFixed(1)} MB...`;
        splashStatus.className = 'text-sm text-gray-600';

        try {
            const token = document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
            const response = await fetch('/api/admin/upload/video', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` },
                body: formData,
            });
            // A proxy rejecting a large body returns HTML, not JSON
            const result = await response.json().catch(() => ({ message: response.status === 413 ? 'Video is too large for the server upload limit.' : `Upload failed (HTTP ${response.status}).` }));
            if (!response.ok) throw new Error(result.message || 'Upload failed');

            splashUrlInput.value = result.filePath;
            setSplashPreview(result.filePath);
            splashStatus.textContent = 'Upload successful! Click "Save Settings" to publish it.';
            splashStatus.className = 'text-sm text-green-600 font-medium';
        } catch (error) {
            splashStatus.textContent = `Error: ${error.message}`;
            splashStatus.className = 'text-sm text-red-600 font-medium';
        }
    });

    splashUrlInput.addEventListener('change', () => setSplashPreview(splashUrlInput.value.trim()));

    document.getElementById('splash-video-remove').addEventListener('click', () => {
        splashUrlInput.value = '';
        setSplashPreview('');
        splashStatus.textContent = 'Video removed. Click "Save Settings" to apply.';
        splashStatus.className = 'text-sm text-gray-600';
    });
    // --- MORE SOCIAL LINKS: add / pick platform / reorder / remove ---
    const SOCIAL_PLATFORMS = <%- JSON.stringify(socialPlatforms || []).replace(/</g, '\\u003c') %>;
    const MAX_EXTRA_SOCIAL = <%= maxExtraSocialLinks || 30 %>;
    const FRONTEND_BASE = <%- JSON.stringify((frontendUrl || '').replace(/\/+$/, '')).replace(/</g, '\\u003c') %>;
    const socialList = document.getElementById('extra-social-list');
    const socialEmpty = document.getElementById('extra-social-empty');
    const addSocialBtn = document.getElementById('add-social-link');
    const platformByKey = Object.fromEntries(SOCIAL_PLATFORMS.map((p) => [p.key, p]));
    const initialExtraSocial = <%- JSON.stringify((settings && settings.extraSocialLinks) || []).replace(/</g, '\\u003c') %>;

    const el = (tag, cls, attrs = {}) => {
        const n = document.createElement(tag);
        if (cls) n.className = cls;
        for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, v);
        return n;
    };

    function refreshSocialState() {
        const rows = socialList.querySelectorAll('[data-social-row]');
        socialEmpty.classList.toggle('hidden', rows.length > 0);
        addSocialBtn.disabled = rows.length >= MAX_EXTRA_SOCIAL;
        addSocialBtn.classList.toggle('opacity-50', addSocialBtn.disabled);
        rows.forEach((row, i) => {
            row.querySelector('[data-move="up"]').disabled = i === 0;
            row.querySelector('[data-move="down"]').disabled = i === rows.length - 1;
        });
    }

    function addSocialRow(item = {}) {
        const row = el('div', 'rounded-lg border border-gray-200 bg-gray-50 p-3', { 'data-social-row': '' });
        const line = el('div', 'flex flex-wrap md:flex-nowrap items-center gap-2');

        const icon = el('img', 'h-9 w-9 rounded-lg object-contain bg-white border shrink-0', { alt: '', width: '36', height: '36' });
        icon.addEventListener('error', () => { icon.style.visibility = 'hidden'; });
        icon.addEventListener('load', () => { icon.style.visibility = 'visible'; });

        const select = el('select', 'form-input !mt-0 w-full md:w-56 shrink-0', { 'aria-label': 'Platform' });
        select.appendChild(new Option('Choose platform…', ''));
        SOCIAL_PLATFORMS.forEach((p) => select.appendChild(new Option(p.label, p.key)));
        select.required = true;
        select.value = platformByKey[item.platform] ? item.platform : '';

        const url = el('input', 'form-input !mt-0 flex-1 min-w-0', { type: 'url', placeholder: 'https://…', 'aria-label': 'Link URL' });
        url.required = true;
        url.value = item.url || '';

        const btnCls = 'h-9 w-9 shrink-0 rounded-md border border-gray-300 bg-white text-gray-600 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed';
        const up = el('button', btnCls, { type: 'button', title: 'Move up', 'aria-label': 'Move up', 'data-move': 'up' }); up.textContent = '↑';
        const down = el('button', btnCls, { type: 'button', title: 'Move down', 'aria-label': 'Move down', 'data-move': 'down' }); down.textContent = '↓';
        const del = el('button', 'h-9 w-9 shrink-0 rounded-md border border-red-200 bg-white text-red-600 hover:bg-red-50', { type: 'button', title: 'Remove', 'aria-label': 'Remove link' });
        del.appendChild(el('i', 'ri-delete-bin-line'));

        line.append(icon, select, url, up, down, del);

        // "Other": custom name + icon
        const other = el('div', 'mt-3 flex flex-wrap items-center gap-2');
        const label = el('input', 'form-input !mt-0 w-full md:w-56', { type: 'text', maxlength: '40', placeholder: 'Name shown on hover (e.g. Our Blog)', 'aria-label': 'Custom name' });
        label.value = item.label || '';
        const iconUrl = el('input', '', { type: 'hidden' });
        iconUrl.value = item.iconUrl || '';
        const fileId = 'social-icon-' + Math.random().toString(36).slice(2);
        const uploadLbl = el('label', 'btn btn-secondary cursor-pointer text-sm', { for: fileId }); uploadLbl.textContent = 'Upload icon';
        const file = el('input', 'sr-only', { type: 'file', id: fileId, accept: 'image/png,image/jpeg,image/webp,image/gif' });
        const status = el('span', 'text-xs text-gray-500'); status.textContent = 'Square PNG/WEBP, at least 64×64.';
        other.append(label, iconUrl, uploadLbl, file, status);

        row.append(line, other);

        const sync = () => {
            const p = platformByKey[select.value];
            const isOther = select.value === 'other';
            other.classList.toggle('hidden', !isOther);
            label.required = isOther;
            const src = isOther && iconUrl.value ? iconUrl.value : (p ? FRONTEND_BASE + p.icon : '');
            if (src) icon.src = src; else { icon.removeAttribute('src'); icon.style.visibility = 'hidden'; }
        };
        select.addEventListener('change', sync);

        file.addEventListener('change', async () => {
            const f = file.files[0];
            file.value = '';
            if (!f) return;
            const fd = new FormData();
            fd.append('image', f);
            status.textContent = 'Uploading…';
            status.className = 'text-xs text-gray-600';
            try {
                const token = document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
                const res = await fetch('/api/admin/upload', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: fd });
                const result = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(result.message || 'Upload failed');
                iconUrl.value = result.filePath;
                sync();
                status.textContent = 'Icon uploaded.';
                status.className = 'text-xs text-green-600 font-medium';
            } catch (err) {
                status.textContent = `Error: ${err.message}`;
                status.className = 'text-xs text-red-600 font-medium';
            }
        });

        up.addEventListener('click', () => { if (row.previousElementSibling) socialList.insertBefore(row, row.previousElementSibling); refreshSocialState(); });
        down.addEventListener('click', () => { if (row.nextElementSibling) socialList.insertBefore(row.nextElementSibling, row); refreshSocialState(); });
        del.addEventListener('click', () => { row.remove(); refreshSocialState(); });

        row._getValue = () => ({ platform: select.value, url: url.value.trim(), label: label.value.trim(), iconUrl: iconUrl.value });
        socialList.appendChild(row);
        sync();
        refreshSocialState();
        return row;
    }

    initialExtraSocial.forEach((item) => addSocialRow(item));
    refreshSocialState();
    addSocialBtn.addEventListener('click', () => {
        const row = addSocialRow();
        row.querySelector('select').focus();
    });

    const getExtraSocialLinks = () =>
        Array.from(socialList.querySelectorAll('[data-social-row]')).map((row) => row._getValue());



    // --- FORM SUBMISSION LOGIC (unchanged) ---
    const form = document.getElementById('settingsForm');
    const submitButton = document.getElementById('submitButton');
    const statusMessageDiv = document.getElementById('statusMessage');
    const apiEndpoint = '<%= apiEndpoint %>';

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitButton.disabled = true;
        submitButton.textContent = 'Saving...';
        statusMessageDiv.textContent = '';
        statusMessageDiv.className = 'text-sm font-medium';

        const formData = {
            logoUrl: document.getElementById('logoUrl').value,
            qrCodeImageUrl: document.getElementById('qrCodeImageUrl').value,
            apkDownloadLink: document.getElementById('apkDownloadLink').value,
            telegramUrl: document.getElementById('telegramUrl').value,
            whatsappUrl: document.getElementById('whatsappUrl').value,
            instagramUrl: document.getElementById('instagramUrl').value,
            facebookUrl: document.getElementById('facebookUrl').value,
            youtubeUrl: document.getElementById('youtubeUrl').value,
            twitterUrl: document.getElementById('twitterUrl').value,
            liveChatUrl: document.getElementById('liveChatUrl').value,
            googleAnalyticsId: document.getElementById('googleAnalyticsId').value,
            googleSearchConsoleVerification: document.getElementById('googleSearchConsoleVerification').value,
            ahrefsVerification: document.getElementById('ahrefsVerification').value,
            customHeaderScripts: document.getElementById('customHeaderScripts').value,
            customFooterScripts: document.getElementById('customFooterScripts').value,
            showSplashVideo: document.getElementById('showSplashVideo').checked,
            splashVideoUrl: document.getElementById('splashVideoUrl').value.trim(),
            extraSocialLinks: getExtraSocialLinks()
        };
        
        try {
            const token = document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
            
            const response = await fetch(apiEndpoint, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                body: JSON.stringify(formData)
            });

            const result = await response.json();
            if (!response.ok) throw new Error(result.message || 'An error occurred.');

            statusMessageDiv.textContent = 'Settings saved successfully!';
            statusMessageDiv.classList.add('text-green-600');
            setTimeout(() => statusMessageDiv.textContent = '', 3000);

        } catch (error) {
            statusMessageDiv.textContent = error.message;
            statusMessageDiv.classList.add('text-red-600');
        } finally {
            submitButton.disabled = false;
            submitButton.textContent = 'Save Settings';
        }
    });
</script>

<%- include('partials/_footer') %>